{
  "name": "doksli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paste a tweet link, keep it as an image.",
  "license": "MIT",
  "author": "fzn0x",
  "homepage": "https://github.com/fzn0x/doksli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzn0x/doksli.git"
  },
